{
  "name": "truesync",
  "version": "1.0.0",
  "description": "Connect. Understand. Visualize. - Arduino IoT control and monitoring platform",
  "main": "dist/main/main.js",
  "homepage": "./",
  "author": "TrueSync Team",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"npm run electron\" \"npm run react-dev\"",
    "react-dev": "vite --host",
    "react-build": "vite build",
    "electron": "wait-on http://localhost:5173 && electron .",
    "electron-dev": "electron .",
    "build": "npm run react-build && npm run electron-build",
    "electron-build": "tsc --project tsconfig.electron.json",
    "start": "electron .",
    "test": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@serialport/bindings-cpp": "^11.1.3",
    "better-sqlite3": "^9.2.2",
    "electron-squirrel-startup": "^1.1.2",
    "framer-motion": "^10.16.16",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.10.3",
    "serialport": "^11.1.1",
    "zustand": "^4.4.1"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "@testing-library/react": "^14.1.2",
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vitest": "^1.1.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.truesync.app",
    "productName": "TrueSync",
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
